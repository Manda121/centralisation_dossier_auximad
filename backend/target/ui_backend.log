  )
  AND (? IS NULL OR d.id_phase = ?)
  AND (? IS NULL OR d.id_statut = ?)
  AND (? IS NULL OR d.id_client = ?)
  AND (? IS NULL OR auximad_vecteur(COALESCE(d.numero_dossier, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR auximad_vecteur(COALESCE(c.nom, '') || ' ' || COALESCE(c.prenom, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR auximad_vecteur(COALESCE(c.cp_client, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR ot.numero_ordre_transit = ?)
  AND (? IS NULL OR d.id_pays_origine = ?)
  AND (? IS NULL OR d.id_pays_destination = ?)
  AND (? IS NULL OR d.id_inconterme = ?)
  AND (? IS NULL OR auximad_vecteur(COALESCE(d.pour_compte, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR auximad_vecteur(COALESCE(d.depart, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR auximad_vecteur(COALESCE(d.adresse_livraison, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR auximad_vecteur(COALESCE(d.lieu_paiement_fret, '')) @@ auximad_recherche_prefixe(?))
  AND (? IS NULL OR d.est_prepaye = ?)
  AND (? IS NULL OR d.est_provisionne = ?)
  AND (? IS NULL OR d.provision_demandee >= ?)
  AND (? IS NULL OR d.provision_demandee <= ?)
  AND (? IS NULL OR d.echeance >= CAST(? AS TIMESTAMP))
  AND (? IS NULL OR d.echeance < CAST(? AS TIMESTAMP) + INTERVAL '1 day')
  AND (? IS NULL OR d.date_livraison >= CAST(? AS TIMESTAMP))
  AND (? IS NULL OR d.date_livraison < CAST(? AS TIMESTAMP) + INTERVAL '1 day')
  AND (? IS NULL OR d.id_type_production = ?)
  AND (? IS NULL OR d.id_ordre_transit = ?)
  AND (? IS NULL OR d.est_groupage = ?)
  AND (? IS NULL OR d.date_creation >= CAST(? AS TIMESTAMPTZ))
  AND (? IS NULL OR d.date_creation <= CAST(? AS TIMESTAMPTZ))
  AND (? IS NULL OR d.id_agence = ?)
  AND (? IS NULL OR EXISTS (
    SELECT 1 FROM type_document td
    WHERE td.id_type_production = d.id_type_production
      AND (td.id_nature_marchandise IS NULL OR td.id_nature_marchandise = ot.id_nature_marchandise)
      AND td.est_obligatoire = true
      AND NOT EXISTS (
        SELECT 1 FROM document doc
        WHERE doc.id_dossier = d.id AND doc.id_type_document = td.id AND doc.est_actif = true
      )
  ))
  AND (? IS NULL OR NOT (? = true AND EXISTS (
    SELECT 1 FROM statut_dossier sx
    WHERE sx.id = d.id_statut
      AND (lower(sx.nom) ~ '^cl.?tur' OR lower(sx.nom) ~ '^ann.?l')
  )))
  AND (? IS NULL OR NOT (? = true AND NOT EXISTS (
    SELECT 1 FROM statut_dossier sx
    WHERE sx.id = d.id_statut AND lower(sx.nom) ~ '^cl.?tur'
  )))
  AND (? IS NULL OR NOT (? = true AND (
    d.echeance IS NULL OR d.echeance >= NOW() OR
    EXISTS (SELECT 1 FROM statut_dossier sx WHERE sx.id = d.id_statut AND lower(sx.nom) ~ '^cl.?tur')
  )))
  AND (? IS NULL OR NOT (? = true AND NOT EXISTS (
    SELECT 1 FROM demande_interagence dge
    WHERE dge.id_dossier = d.id AND dge.statut = 'EN_ATTENTE'
  )))
  AND (
    ? IS NULL OR ? = '' OR
    (? = 'INTERAGENCE' AND (
       EXISTS (SELECT 1 FROM dossier_interagence di WHERE di.id_sous_dossier = d.id) OR
       EXISTS (SELECT 1 FROM dossier_interagence di WHERE di.id_dossier_mere = d.id)
    )) OR
    (? = 'MERE' AND EXISTS (SELECT 1 FROM dossier_interagence di WHERE di.id_dossier_mere = d.id)) OR
    (? = 'SOUS_DOSSIER' AND EXISTS (SELECT 1 FROM dossier_interagence di WHERE di.id_sous_dossier = d.id))
  )
 order by d.date_creation desc fetch first ? rows only
